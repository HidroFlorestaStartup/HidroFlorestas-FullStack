  "conclusions": {
    "sameCommandTwoFrames": "3/3 reproduce early readiness resolution with pendingFocus=true; target y591 becomes1696 after the queued focus callback. This is a renderer-level causal counterproof, not the exact two-command helper execution.",
    "sameCommandMessageTask": "3/3 keep focus work before readiness resolution; target remains y591 and unobstructed.",
    "exactTwoCommands": "3/3 remain unobstructed with the published helper. The second Playwright/CDP command arrived after the focus callback in these trials; no exact-helper failure was observed.",
    "taskTwoCommands": "3/3 remain unobstructed with the MessageChannel task and existing finite-animation recheck.",
    "recommendation": "Make readiness itself drain the pending render callback by posting a MessageChannel task after the second rAF, closing both ports when delivered, then rechecking finite running animations. This removes dependence on the incidental protocol roundtrip order."
  },
  "limits": [
    "Controlled late intrinsic resize fixture, not the full React application or Windows official CI.",
