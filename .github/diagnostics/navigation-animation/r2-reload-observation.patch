+async function installEnvironmentalReloadObservation(page: Page) {
+  await page.addInitScript(() => {
+    const selector = '[data-environmental-value="soil.infiltrationRateMmPerHour"]';
+    const records: unknown[] = [];
+    const identities = new WeakMap<Element, number>();
+    const errors = { hydrationRelated: 0, other: 0 };
+    let nextIdentity = 0;
+    let droppedRecords = 0;
+    let previousState = '';
+    const describe = (node: Element) => {
+      const style = getComputedStyle(node);
+      const box = node.getBoundingClientRect();
+      const idKind = node.id === 'application-content' ? 'application-content'
+        : /^S:/.test(node.id) ? 'react-segment-shaped'
+        : /^B:/.test(node.id) ? 'react-boundary-shaped'
+        : node.id ? 'other-id-present' : 'no-id';
+      return { tag: node.tagName, idKind,
+        hidden: node.hasAttribute('hidden'), inert: node.hasAttribute('inert'),
+        ariaHidden: node.getAttribute('aria-hidden') === 'true',
+        display: style.display, visibility: style.visibility,
+        contentVisibility: style.contentVisibility,
+        width: Math.round(box.width * 100) / 100,
+        height: Math.round(box.height * 100) / 100,
+        closedDetails: node.tagName === 'DETAILS' && !node.hasAttribute('open') };
+    };
+    const sample = (reason: string, force = false) => {
+      const targets = Array.from(document.querySelectorAll(selector)).map(node => {
+        if (!identities.has(node)) identities.set(node, ++nextIdentity);
+        const ancestry = [];
+        for (let ancestor: Element | null = node; ancestor; ancestor = ancestor.parentElement) {
+          ancestry.push(describe(ancestor));
+        }
+        return { identity: identities.get(node), connected: node.isConnected,
+          inApplicationContent: node.closest('#application-content') !== null,
+          textMatchesExpected: node.textContent === '0.0000004 mm/h',
+          rectCount: node.getClientRects().length,
+          browserVisible: node.checkVisibility({ checkVisibilityCSS: true }),
+          ancestry };
+      });
+      const state = { readyState: document.readyState,
+        shellCount: document.querySelectorAll('#application-content').length,
+        totalMatches: targets.length, targets };
+      const fingerprint = JSON.stringify(state);
+      if (!force && fingerprint === previousState) return;
+      previousState = fingerprint;
+      // Keep the initial eight states and the most recent forty, with explicit loss.
+      if (records.length === 48) { records.splice(8, 1); droppedRecords++; }
+      records.push({ atMs: Math.round(performance.now()), reason, ...state });
+    };
+    const observer = new MutationObserver(() => sample('mutation'));
+    const onDomReady = () => sample('domcontentloaded', true);
+    const onLoad = () => sample('load', true);
+    const onError = (event: ErrorEvent) => {
+      if (/hydration|hydrating|server rendered HTML|text content does not match/i.test(event.message)) errors.hydrationRelated++;
+      else errors.other++;
+    };
+    observer.observe(document, { subtree: true, childList: true, characterData: true,
+      attributes: true, attributeFilter: ['hidden', 'inert', 'aria-hidden', 'style', 'class', 'open'] });
+    document.addEventListener('DOMContentLoaded', onDomReady, { once: true });
+    window.addEventListener('load', onLoad, { once: true });
+    window.addEventListener('error', onError);
+    sample('init', true);
+    (window as Window & { __environmentalR2Observation?: () => unknown }).__environmentalR2Observation = () => {
+      sample('assertions-final', true);
+      observer.disconnect();
+      document.removeEventListener('DOMContentLoaded', onDomReady);
+      window.removeEventListener('load', onLoad);
+      window.removeEventListener('error', onError);
+      return { recorded: true, droppedRecords, errors, records };
+    };
+  });
+}
