+/** The app uses a 300ms universal CSS transition, including html font-size.
+ * Two requestAnimationFrame callbacks are NOT a font-scale readiness gate.
+ * Observe the real computed value (without changing product CSS) until it
+ * reaches the exact requested value; record bounded diagnostics on failure.
+ */
+async function waitForFontScale(runtime: Runtime, c: MatrixCase, phase: string) {
+  const expectedPx = c.scale === 200 ? 32 : 16;
+  const sampledPx: number[] = [];
+  try {
+    await expect.poll(async () => {
+      const px = await runtime.page.evaluate(() =>
+        parseFloat(getComputedStyle(document.documentElement).fontSize));
+      sampledPx.push(px);
+      return px;
+    }, { timeout: 3_000, intervals: [25, 50, 100, 150, 200] }).toBe(expectedPx);
+    // The font scale has reached its final value. Check it again after layout.
+    await settle(runtime.page);
+    const finalPx = await runtime.page.evaluate(() =>
+      parseFloat(getComputedStyle(document.documentElement).fontSize));
+    expect(finalPx).toBe(expectedPx);
+  } catch (error) {
+    report.scaleDiagnostics.push({ source: runtime.source, caseId: c.id, phase,
+      expectedPx, sampledPx: sampledPx.slice(-20) });
+    await saveReport(); // preserve evidence before a failing assertion ends the test
+    throw error;
+  }
+}
