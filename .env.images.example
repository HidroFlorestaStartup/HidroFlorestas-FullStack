# Disabled by default. Obtain reviewed values for the chosen environment.
# Policy A confirmed 2026-10-15: disabled blocks upload, confirmation, removal
# and content; authorized metadata and persisted covers are preserved.
# Never use NEXT_PUBLIC_ for provider secrets. No credential examples.
CLOUDINARY_IMAGE_ENABLED=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed, versioned, frozen preset with no incoming/eager/add-ons/scripts.
CLOUDINARY_COVER_PRESET=hfr-cover-v1
CLOUDINARY_COVER_PRESET_SHA256=
