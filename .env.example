# HidroFlorestas - configuração local de exemplo
# Nunca registre valores reais, tokens ou credenciais neste arquivo.

# Aplicação e banco PostgreSQL/Neon
DATABASE_URL=
JWT_SECRET=
ROOT_PASSWORD=
APP_PUBLIC_URL=http://localhost:3000

# Mapa. Em desenvolvimento, a aplicação possui fallback para OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Política de contas e proteção criptográfica.
# Gere chaves independentes de 32 bytes em base64; não reutilize JWT_SECRET.
ACCOUNT_POLICY_ENABLED=1
ACCOUNT_TRUSTED_INGRESS=
ACCOUNT_TESTER_ALLOWLIST=
ACCOUNT_PROOF_KEYS=
ACCOUNT_PROOF_ACTIVE_KEY_ID=
ACCOUNT_REQUEST_KEY=
ACCOUNT_VERIFICATION_TTL_SECONDS=900
ACCOUNT_VERIFICATION_ATTEMPTS=5
ACCOUNT_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_VERIFICATION_SENDS_PER_HOUR=5
ACCOUNT_RESET_TTL_SECONDS=1800
ACCOUNT_RESET_REQUESTS_PER_HOUR=3
ACCOUNT_GLOBAL_REQUESTS_PER_HOUR=100

# Fila e worker de e-mail. Necessários apenas para fluxos de verificação/reset.
MAIL_PAYLOAD_ENCRYPTION_KEYS=
MAIL_PAYLOAD_ACTIVE_KEY_ID=
MAIL_IDEMPOTENCY_KEY=
MAIL_WORKER_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=

# Imagens de capa. Desabilitado por padrão.
# Nunca exponha CLOUDINARY_API_SECRET com prefixo NEXT_PUBLIC_.
CLOUDINARY_IMAGE_ENABLED=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_COVER_PRESET=hfr-cover-v1
CLOUDINARY_COVER_PRESET_SHA256=
